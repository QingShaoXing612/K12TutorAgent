# ===== 数据库（PostgreSQL）=====
DB_HOST=localhost
DB_PORT=5433                 # 与本机已有 PG(5432) 隔离
DB_NAME=eduagent
DB_USER=eduagent_user
DB_PASSWORD=<请填写数据库密码>

# ===== Milvus 向量库 =====
MILVUS_HOST=localhost
MILVUS_PORT=19531            # 与本机已有 Milvus(19530) 隔离

# ===== DeepSeek 大模型 =====
DEEPSEEK_API_KEY=<请填写DeepSeek的APIKey>
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_CHAT=deepseek-chat
DEEPSEEK_MODEL_CODER=deepseek-coder

# ===== 本地模型路径 =====
RERANKER_MODEL_PATH=./models/reranker/bge-reranker-large
CLASSIFIER_MODEL_PATH=./models/classifier/all-MiniLM-L6-v2
BGE_M3_MODEL_PATH=./models/embedding/bge-m3

# ===== JWT 认证 =====
JWT_SECRET_KEY=<请填写64位随机hex，可用 openssl rand -hex 32 生成>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== Web 搜索（可选，留空则用免费的 DuckDuckGo）=====
TAVILY_API_KEY=

# ===== 应用配置 =====
APP_ENV=local
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default
